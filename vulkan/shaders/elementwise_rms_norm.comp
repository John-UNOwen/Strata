#version 450

// vulkan/shaders/elementwise_rms_norm.comp - strata::kernels::rms_norm_weighted.
//
// ONE WORKGROUP PER ROW, reduced through workgroup shared memory.  The CUDA body (src/kernels/cuda/elementwise.cu:88
// -111) uses one WARP per row with __shfl_down_sync, 4 warps to a block, and its launcher rounds the grid up to whole
// blocks - which is why its row guard matters (the comment there says the missing guard was the QSA bug: a rows=2 call
// ran eight warps and wrote two rows past the end of the k cursor, over the v cursor).
//
// The first version of this file copied that shape with GL_KHR_shader_subgroup_shuffle and a 32-lane stride over the
// columns, and it was wrong in a way the shared driver measured as "rel 7.652e-01".  vk_norm_probe pinned it: a row of
// 32 twos came back normalised by 1/sqrt(2) instead of 1/sqrt(4), i.e. the sum held 64 and not 128 - HALF the lanes'
// partial sums.  The reason is that nothing here asked the driver for a subgroup size: subgroupSize 32 is what the
// device LIMITS report, but a 128-lane workgroup may be split differently, and a hardcoded stride of 32 then covers
// only half the row while the shuffle butterfly sums within whatever the driver chose.  A shared-memory reduction over
// the whole workgroup does not care what the subgroup size is, and one workgroup per row removes the row guard
// entirely, so a rows=2 call launches 2 workgroups and nothing writes past the end.
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Push {
    uint64_t x;
    uint64_t w;
    int64_t  rows;
    int64_t  cols;
    float    eps;
    uint     has_w;
    uint64_t stream;
} pc;

layout(set = 0, binding = 0) buffer X { float v[]; } xb;
layout(set = 0, binding = 1) buffer W { float w[]; } wb;

shared float part[128];

void main() {
    const int l = int(gl_LocalInvocationID.x);
    const int row = int(gl_WorkGroupID.x);                 // the launcher passes rows workgroups
    if (int64_t(row) >= pc.rows) return;
    const int cols = int(pc.cols);                         // GLSL indexes with int
    const int base = row * cols;

    float acc = 0.0f;
    for (int c = l; c < cols; c += 128) acc += xb.v[base + c] * xb.v[base + c];
    part[l] = acc;
    barrier();
    for (int s = 64; s > 0; s >>= 1) {
        if (l < s) part[l] += part[l + s];
        barrier();                                         // every lane reaches this, the add does not
    }

    // The MEAN, not the sum: ref/qsa.py::rms_norm divides by np.mean(np.square(x)).
    const float inv = inversesqrt(part[0] / float(cols) + pc.eps);

    for (int c = l; c < cols; c += 128) {
        const float v = (pc.has_w != 0u) ? xb.v[base + c] * wb.w[c] : xb.v[base + c];
        xb.v[base + c] = v * inv;
    }
}
