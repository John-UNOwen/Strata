#version 450 core
// P2 read pass: read the tags back through the same device address and report each one.
// Row 0 means the read happened; the value is what the shader actually saw.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, buffer_reference_align = 8) buffer BigRef { uint64_t w[]; };

struct Row { uint64_t ok; uint64_t val; };

layout(push_constant) uniform PC { uint stride; uint count; uint a; uint b; } pc;

layout(set = 0, binding = 0, scalar) buffer Addr { uint64_t addr; } ab;
layout(set = 0, binding = 1, scalar) buffer Out { Row row[]; } outb;

uint64_t mix64(uint64_t x) {
    x ^= (x >> 30u);
    x *= 0xbf58476d1ce4e5b9ul;
    x ^= (x >> 27u);
    x *= 0x94d049bb133111ebul;
    x ^= (x >> 31u);
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) { return; }
    uint64_t base = (uint64_t(pc.b) << 32u) | uint64_t(pc.a);
    BigRef big = BigRef(ab.addr + base);
    uint64_t v = big.w[(pc.stride / 8u) * i];
    outb.row[i].ok = (v == mix64(uint64_t(i))) ? 1ul : 0ul;
    outb.row[i].val = v;
}
