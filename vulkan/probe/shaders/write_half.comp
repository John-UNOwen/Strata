#version 450 core
// P3 write pass: this card writes its own half of a host allocation, in place.
// The marker (mix(i) ^ 0xa5a5...) lets the host tell a GPU write from its own original value.
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC { uint stride; uint count; uint first; uint last; } pc;

layout(set = 0, binding = 0, scalar) buffer Host { uint64_t w[]; } hb;

uint64_t mix64(uint64_t x) {
    x ^= (x >> 30u);
    x *= 0xbf58476d1ce4e5b9ul;
    x ^= (x >> 27u);
    x *= 0x94d049bb133111ebul;
    x ^= (x >> 31u);
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.first || i >= pc.last) { return; }
    hb.w[(pc.stride / 8u) * i] = mix64(uint64_t(i)) ^ 0xa5a5a5a5a5a5a5a5ul;
}
