#version 450 core
// P2b write pass: reach a region of one buffer through an ordinary descriptor binding, with no
// 64-bit device address anywhere. Binding 1 is only here so the descriptor layout matches P2.
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC { uint stride; uint count; uint a; uint b; } pc;

layout(set = 0, binding = 0, scalar) buffer Big { uint64_t w[]; } big;
layout(set = 0, binding = 1, scalar) buffer Sink { uint64_t w[]; } sink;

uint64_t mix64(uint64_t x) {
    x ^= (x >> 30u);
    x *= 0xbf58476d1ce4e5b9ul;
    x ^= (x >> 27u);
    x *= 0x94d049bb133111ebul;
    x ^= (x >> 31u);
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) { return; }
    big.w[(pc.stride / 8u) * i] = mix64(uint64_t(i));
}
